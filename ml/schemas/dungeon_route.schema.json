{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinity-cata.local/schemas/dungeon_route.schema.json",
  "title": "DungeonRoute",
  "type": "object",
  "required": ["route_id", "map_id", "steps"],
  "additionalProperties": false,
  "properties": {
    "route_id": {"type": "string", "minLength": 1},
    "dungeon_id": {"type": "integer", "minimum": 0},
    "map_id": {"type": "integer", "minimum": 0},
    "zone_id": {"type": "integer", "minimum": 0},
    "description": {"type": "string"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": true,
        "properties": {
          "type": {"enum": ["move", "pull_pack", "boss", "recover", "checkpoint"]},
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {"type": "number"}
          },
          "pack_id": {"type": "string"},
          "boss_id": {"type": ["integer", "string"]},
          "strategy": {"type": "string"},
          "mechanics": {"type": "array", "items": {"type": "object"}},
          "hazard_source_entry": {"type": "integer", "minimum": 0},
          "hazard_detection_spell_id": {"type": "integer", "minimum": 0},
          "hazard_damage_spell_id": {"type": "integer", "minimum": 0},
          "hazard_shape": {"type": "string", "enum": ["radial", "frontal_cone"]},
          "hazard_radius_yards": {"type": "number", "minimum": 0},
          "hazard_safety_margin_yards": {"type": "number", "minimum": 0},
          "split_source_guids": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "split_minimum_separation_yards": {"type": "number", "exclusiveMinimum": 0},
          "split_navigation_margin_yards": {"type": "number", "minimum": 0},
          "split_arrival_tolerance_yards": {"type": "number", "exclusiveMinimum": 0},
          "split_lane_a_roster_slots": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "split_lane_b_roster_slots": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "split_lane_tank_slots": {
            "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "thunderclap_spell_id": {"type": "integer", "minimum": 1},
          "charge_spell_id": {"type": "integer", "minimum": 1},
          "charge_range_yards": {"type": "number", "exclusiveMinimum": 0},
          "charge_native_interval_ms": {"type": "integer", "minimum": 1},
          "vengeful_rage_spell_id": {"type": "integer", "minimum": 1},
          "expected_duration_sec": {"type": "number", "minimum": 0}
        }
      }
    }
  }
}
